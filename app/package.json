{
  "name": "devops-app",
  "version": "1.0.0",
  "description": "Sample application for Jenkins CI/CD pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm run test && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=tests/unit --coverage --coverageReporters=text-lcov --coverageReporters=cobertura",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "security-check": "npm audit && snyk test"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.50.0",
    "nodemon": "^3.0.1",
    "snyk": "^1.1200.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["nodejs", "express", "cicd", "jenkins", "devops"],
  "author": "Alam <kh.maksudul.alam.cse@gmail.com>",
  "license": "MIT"
}
